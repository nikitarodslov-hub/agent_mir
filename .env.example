# Claude AI API key (get at https://console.anthropic.com)
CLAUDE_API_KEY=sk-ant-...

# Bitrix24 URL (e.g. https://mycompany.bitrix24.ru)
BITRIX_URL=https://your-company.bitrix24.ru

# MoySklad credentials (optional, for inventory checks)
MOYSKLAD_LOGIN=user@email.com
MOYSKLAD_PASSWORD=your_password

# Open Lines section URL path (default: /crm/chats/)
BITRIX_OPENLINES_PATH=/crm/chats/
